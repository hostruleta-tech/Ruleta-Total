# ============================================================
# RULETA TOTAL - Variables para Vercel (monorepo)
# ============================================================
# Copia este archivo y configura en Vercel Dashboard ? Settings ? Environment Variables
# Marca TODAS en: Production + Preview + Development
# ============================================================

# --------------------------------------------------------------
# BACKEND (Turso + Auth + Tickets/QR)
# --------------------------------------------------------------

# Base de datos Turso (ya la tienes en Vercel como TURSO_DATABASE_URL)
TURSO_DATABASE_URL=libsql://ruleta-edwinforwork14.aws-us-east-2.turso.io

# Token de Turso (ya la tienes en Vercel como TURSO_AUTH_TOKEN)
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# Panel de operador - Cambia por tu password segura
OPERATOR_PASSWORD=cambia_esto_por_password_segura

# Firma de cookies de sesión operador (genera una vez):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=genera_32_bytes_hex_aqui

# Encriptación de tokens QR para tickets (genera una vez):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TICKET_ENCRYPTION_KEY=genera_32_bytes_base64_aqui

# URL pública donde está el frontend (para generar QRs correctos)
# En Vercel: https://ruleta-total.vercel.app  |  En dominio propio: https://tudominio.com
PUBLIC_APP_URL=https://ruleta-total.vercel.app

# Modo producción (activa cookies Secure, HTTPS obligatorio, etc.)
NODE_ENV=production

# --------------------------------------------------------------
# FRONTEND (Vite - solo variables con prefijo VITE_)
# --------------------------------------------------------------

# URL del backend API (en Vercel mismo dominio ? /api)
VITE_API_URL=/api

# Subruta si deployas en https://tudominio.com/ruleta/
# En dominio raíz: /
VITE_BASE_PATH=/

# ============================================================
# CÓMO GENERAR LOS SECRETOS (ejecuta en terminal):
# ============================================================
# SESSION_SECRET:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TICKET_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 
# Luego pégalos en Vercel Dashboard ? Settings ? Environment Variables
# Marca: Production + Preview + Development en CADA variable
# ============================================================
