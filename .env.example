# ===== PRODUCCIÓN VPS (copia a .env y ajusta valores reales) =====

# Base de datos MariaDB (en producción en VPS)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=ruleta
MARIADB_USER=root
MARIADB_PASSWORD=

# App
NODE_ENV=production
PUBLIC_APP_URL=https://REEMPLAZAR_CON_TU_DOMINIO.com

# Puerto backend (interno, no expuesto directamente a Internet)
PORT=3001

# Operador (panel de administración)
OPERATOR_PASSWORD=REEMPLAZAR_CONTRASEÑA_OPERADOR

# Clave encriptación tickets / firma de sesión (32 bytes base64)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TICKET_ENCRYPTION_KEY=REEMPLAZAR_CLAVE_ENCRIPTACION

# Secreto de sesión operador (opcional; si no se usa deriva de TICKET_ENCRYPTION_KEY)
SESSION_SECRET=REEMPLAZAR_SECRETO_SESION

# ===== MIGRACIÓN TURSO → MARIA DB (solo para pruebas) =====
# Usar este archivo para exportar datos de Turso y luego importarlos a MariaDB:
# 1. Exportar datos de Turso: node backend/push-turso.js > turso-export.json
# 2. Importar a MariaDB: node backend/migrate-turso.js turso-export.json