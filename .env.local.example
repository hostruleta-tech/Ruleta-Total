# ===== DESARROLLO LOCAL (copia a .env.local y ajusta) =====
# IMPORTANTE: Esto evita escribir en la BD real de Turso mientras desarrollas

# BD local SQLite (archivo en disco, no Turso)
TURSO_DATABASE_URL=file:./local-dev.db
TURSO_AUTH_TOKEN=local-dev-token-no-se-usa

# Opcional: si quieres probar contra Turso real, descomenta y usa tus credenciales
# TURSO_DATABASE_URL=libsql://tu-proyecto.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# App
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# Operador (para login en panel local)
OPERATOR_PASSWORD=cambia-esto-en-produccion

# Clave de encriptación tickets (32 bytes base64)
# Genera una: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TICKET_ENCRYPTION_KEY=clave-local-solo-para-desarrollo-no-usar-en-prod

# Secreto de sesión operador (opcional, si no se usa deriva de TICKET_ENCRYPTION_KEY)
# SESSION_SECRET=otra-clave-aleatoria-larga