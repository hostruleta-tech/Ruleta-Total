# Copia este archivo a `.env` y rellena los valores.
# En Vercel, configura estas mismas variables en
# Settings → Environment Variables.

# ---- Turso (https://turso.tech) ----
# Dashboard → Databases → tu base → Create Token
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# ---- Panel de administración ----
# Credenciales para entrar al panel.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secreto interno para firmar las sesiones del panel (no es la contraseña).
# Genera un valor aleatorio con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your-secure-random-token-here
