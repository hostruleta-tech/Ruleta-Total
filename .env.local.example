# Copia este archivo a `.env` y rellena los valores.
# En Vercel, configura estas mismas variables en
# Settings → Environment Variables.

# ---- Turso (https://turso.tech) ----
# Dashboard → Databases → tu base → Create Token
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# ---- Base de datos y variables opcionales ----
# (La ruleta pública no requiere credenciales; el panel de administración sí).

# ---- Tickets QR ----
# URL pública real de la app. En producción debe ser HTTPS.
# En local, usa el puerto que muestre Vite (por ejemplo http://localhost:5173).
PUBLIC_APP_URL=http://localhost:5173

# Contraseña que se pedirá para crear/editar ruletas y gestionar tickets.
OPERATOR_PASSWORD=cambia-esta-contraseña

# Clave de 32 bytes en base64 para cifrar el token de los tickets.
# Genérala con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TICKET_ENCRYPTION_KEY=REEMPLAZA_CON_LA_CLAVE_GENERADA
