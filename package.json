{
	"name": "r",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -p backend/tsconfig.json",
		"build:frontend": "vite build",
		"build:backend": "tsc -p backend/tsconfig.json",
		"lint": "eslint .",
		"preview": "vite preview",
		"start": "node backend/dist/server.js",
		"deploy:build": "npm run build",
		"deploy:start": "npm start",
		"install:all": "npm install && cd backend && npm install",
		"build:all": "npm run build:frontend && npm run build:backend",
		"clean": "rimraf dist backend/dist",
		"typecheck": "tsc --noEmit",
		"dev:backend": "cd backend && npx tsx watch server.ts",
		"dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\""
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.2.8",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@tailwindcss/vite": "^4.1.16",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.552.0",
		"react": "^19.1.1",
		"react-confetti": "^6.4.0",
		"react-custom-roulette": "^1.4.1",
		"react-dom": "^19.1.1",
		"react-hook-roulette": "^0.0.10",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.3",
		"@eslint/js": "^9.36.0",
		"@types/node": "^24.6.0",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.4",
		"concurrently": "^9.1.2",
		"eslint": "^9.36.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.22",
		"globals": "^16.4.0",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.1.7"
	}
}
