# Base de datos Turso
TURSO_DATABASE_URL=libsql://ruleta-edwinforwork14.aws-us-east-2.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# Panel de operador
OPERATOR_PASSWORD=cambia_esto_por_password_segura

# Firma de cookies sesión (genera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=genera_32_bytes_hex_aqui

# Encriptación tokens QR tickets (genera: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TICKET_ENCRYPTION_KEY=genera_32_bytes_base64_aqui

# URL pública para QRs (https://ruleta-total.vercel.app o tu dominio)
PUBLIC_APP_URL=https://ruleta-total.vercel.app

# Modo producción
NODE_ENV=production
