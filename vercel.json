{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:backend && npm run build:frontend",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "backend/dist/**"
    }
  },
  "rewrites": [
    { "source": "/login-admin", "destination": "/index.html" },
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" },
    { "source": "/api-ruleta/:path*", "destination": "/api/index?__path=:path*" }
  ]
}
